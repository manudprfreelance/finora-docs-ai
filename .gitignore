# ============================================================
# Finora Docs AI
# Git ignore rules
# ============================================================

# Environment variables / secrets
.env
.env.*
!.env.example
*.env

# Credentials / certificates / keys
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets/
credentials/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Database local data
postgres-data/
*.sqlite
*.sqlite3
*.db

# n8n runtime data
.n8n/
n8n-data/

# Generated documents
generated/
generated-documents/
*.generated.pdf

# Temporary files
tmp/
temp/
.cache/

# Docker local overrides
docker-compose.override.yml

# Test artifacts
test-results/
playwright-report/

# Local synthetic/runtime uploads
uploads/
storage/